  "status_rules": {
    "drilled": "appears in ≥1 logged session (cooperative)",
    "grooved": "drilled across ≥3 distinct sessions spanning ≥3 weeks",
    "live": "landed under resistance on ≥2 occasions vs ≥2 different partners",
    "coach-verified": "coach sign-off only — never inferred",
    "integrity": "0-3 derived from logs, never hand-settable; staleness is visual, never a demotion"
